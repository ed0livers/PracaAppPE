# ============================================
# CONFIGURAÇÕES DO BACKEND (Java/Spring Boot)
# ============================================

# Banco de Dados MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/praca_app
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456

# Configurações JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# ============================================
# CONFIGURAÇÕES DO FRONTEND (React Native/Expo)
# ============================================

# IP do computador na rede Wi-Fi
# ALERTA: Altere este valor para o IP da sua máquina na rede local
# Windows: ipconfig | Mac/Linux: ifconfig
REACT_NATIVE_API_HOST=192.168.1.12
REACT_NATIVE_API_PORT=8080
REACT_NATIVE_API_URL=http://192.168.1.12:8080/api

# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================

# Ambiente de execução (development, production)
NODE_ENV=development
EXPO_PUBLIC_API_URL=http://192.168.1.12:8080/api
